generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(EMPLOYEE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses        Expense[]
  decidedExpenses Expense[] @relation("ExpenseDecisionMaker")
}

model Expense {
  id          Int       @id @default(autoincrement())
  title       String
  vendor      String?
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  expenseDate DateTime?

  // Original OCR receipt — immutable after expense creation
  ocrReceiptUrl  String?
  ocrReceiptPath String?
  ocrRawText     String?

  // Bill proof — can be replaced/removed
  billProofUrl  String?
  billProofPath String?

  status          ExpenseStatus @default(PENDING)
  decidedAt       DateTime?
  decidedById     Int?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  decidedBy User? @relation("ExpenseDecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)
}
