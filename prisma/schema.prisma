generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int                           @id @default(autoincrement())
  name                          String
  email                         String                        @unique
  password                      String?
  role                          Role                          @default(EMPLOYEE)
  createdAt                     DateTime                      @default(now())
  emailVerified                 DateTime?
  image                         String?
  updatedAt                     DateTime                      @updatedAt
  isActive                      Boolean                       @default(true)
  defaultCurrency               String                        @default("INR")
  deletedByExpenses             DeletedExpense[]              @relation("DeletedExpenseAdmin")
  deletedExpenses               DeletedExpense[]              @relation("DeletedExpenseOwner")
  reviewedEmployeeVerifications EmployeeVerificationRequest[] @relation("EmployeeVerificationReviewer")
  employeeVerificationRequests  EmployeeVerificationRequest[]
  decidedExpenses               Expense[]                     @relation("ExpenseDecisionMaker")
  reimbursementExpenses         Expense[]                     @relation("ExpenseReimbursementProcessor")
  expenses                      Expense[]
  expenseAuditLogs              ExpenseAuditLog[]             @relation("ExpenseAuditActor")
  reviewedNameChanges           NameChangeRequest[]           @relation("NameChangeReviewer")
  nameChangeRequests            NameChangeRequest[]           @relation("NameChangeRequester")
  notifications                 Notification[]
  passwordResetTokens           PasswordResetToken[]
  reviewedRoleRequests          RoleVerificationRequest[]     @relation("RoleRequestReviewer")
  roleRequests                  RoleVerificationRequest[]
}

model Expense {
  id                  Int                 @id @default(autoincrement())
  title               String
  amount              Decimal             @db.Decimal(12, 2)
  category            String
  createdAt           DateTime            @default(now())
  userId              Int?
  expenseDate         DateTime?
  updatedAt           DateTime            @updatedAt
 
  vendor              String?
  decidedAt           DateTime?
  decidedById         Int?
  rejectionReason     String?
  status              ExpenseStatus       @default(PENDING)
  ocrRawText          String?
  ocrReceiptPath      String?
  ocrReceiptUrl       String?
  reimbursementStatus ReimbursementStatus @default(PENDING)
  reimbursementAt     DateTime?
  reimbursementById   Int?
  reimbursementReason String?
  baseCurrencyAmount  Decimal?            @db.Decimal(12, 2)
  currency            String              @default("INR")
  exchangeRate        Decimal?            @db.Decimal(18, 8)
  exchangeRateAt      DateTime?
  decidedBy           User?               @relation("ExpenseDecisionMaker", fields: [decidedById], references: [id])
  reimbursementBy     User?               @relation("ExpenseReimbursementProcessor", fields: [reimbursementById], references: [id])
  user                User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs           ExpenseAuditLog[]
  notifications       Notification[]
}

model RoleVerificationRequest {
  id              Int               @id @default(autoincrement())
  requestedRole   Role
  proofUrl        String?
  proofPath       String?
  status          RoleRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userId          Int
  deadlineAt      DateTime?
  reminderSentAt  DateTime?
  reviewedBy      User?             @relation("RoleRequestReviewer", fields: [reviewedById], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeVerificationRequest {
  id              Int                        @id @default(autoincrement())
  proofUrl        String?
  proofPath       String?
  status          EmployeeVerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  userId          Int
  deadlineAt      DateTime?
  reminderSentAt  DateTime?
  reviewedBy      User?                      @relation("EmployeeVerificationReviewer", fields: [reviewedById], references: [id])
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NameChangeRequest {
  id              Int                     @id @default(autoincrement())
  currentName     String
  requestedName   String
  status          NameChangeRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  userId          Int
  proofPath       String?
  proofUrl        String?
  reason          String
  deadlineAt      DateTime?
  reminderSentAt  DateTime?
  reviewedBy      User?                   @relation("NameChangeReviewer", fields: [reviewedById], references: [id])
  user            User                    @relation("NameChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseAuditLog {
  id        Int                @id @default(autoincrement())
  action    ExpenseAuditAction
  expenseId Int?
  actorId   Int?
  details   String?
  createdAt DateTime           @default(now())
  metadata  Json?
  reason    String?
  actor     User?              @relation("ExpenseAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  expense   Expense?           @relation(fields: [expenseId], references: [id])
}

model DeletedExpense {
  id                Int       @id @default(autoincrement())
  originalExpenseId Int
  title             String
  amount            Decimal   @db.Decimal(12, 2)
  category          String
  expenseDate       DateTime?
  ocrReceiptUrl     String?
  ocrReceiptPath    String?
  ocrRawText        String?
 
  deletionReason    String
  deletedAt         DateTime  @default(now())
  deletedById       Int
  userId            Int
  currency          String    @default("INR")
  deletedBy         User      @relation("DeletedExpenseAdmin", fields: [deletedById], references: [id])
  user              User      @relation("DeletedExpenseOwner", fields: [userId], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  userId    Int
  expenseId Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  expense   Expense?         @relation(fields: [expenseId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id                  Int       @id @default(autoincrement())
  userId              Int
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  usedAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([resetTokenHash])
}

enum Role {
  ADMIN
  EMPLOYEE
  HR
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReimbursementStatus {
  PENDING
  REIMBURSED
  REJECTED
}

enum ExpenseAuditAction {
  CREATED
  UPDATED
  DELETED
  APPROVED
  REJECTED
  REIMBURSED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_MODIFIED
  EXPENSE_DELETED
  REIMBURSEMENT_PENDING
  EXPENSE_REIMBURSED
  REIMBURSEMENT_REJECTED
  EMPLOYEE_ACCOUNT_CREATED
  EMPLOYEE_ACCOUNT_DEACTIVATED
  EMPLOYEE_ACCOUNT_UPDATED
  ROLE_UPGRADED
  ROLE_DOWNGRADED
  ROLE_CHANGED
  ROLE_VERIFICATION_PENDING
  ROLE_VERIFICATION_APPROVED
  ROLE_VERIFICATION_REJECTED
  EMPLOYEE_VERIFICATION_PENDING
  EMPLOYEE_VERIFICATION_APPROVED
  EMPLOYEE_VERIFICATION_REJECTED
  ADMIN_ACTION
  SYSTEM
  EMPLOYEE_ACCOUNT_ACTIVATED
}

enum NameChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
