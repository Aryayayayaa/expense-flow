generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReimbursementStatus {
  PENDING
  REIMBURSED
  REJECTED
}

enum ExpenseAuditAction {
  CREATED
  UPDATED
  DELETED
  APPROVED
  REJECTED
  REIMBURSED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(EMPLOYEE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses        Expense[]
  decidedExpenses Expense[] @relation("ExpenseDecisionMaker")

  reimbursementExpenses Expense[] @relation("ExpenseReimbursementProcessor")

  expenseAuditLogs ExpenseAuditLog[] @relation("ExpenseAuditActor")

  deletedExpenses   DeletedExpense[] @relation("DeletedExpenseOwner")
  deletedByExpenses DeletedExpense[] @relation("DeletedExpenseAdmin")

  roleRequests         RoleVerificationRequest[]
  reviewedRoleRequests RoleVerificationRequest[] @relation("RoleRequestReviewer")

  employeeVerificationRequests  EmployeeVerificationRequest[]
  reviewedEmployeeVerifications EmployeeVerificationRequest[] @relation("EmployeeVerificationReviewer")
}

model Expense {
  id          Int       @id @default(autoincrement())
  title       String
  vendor      String?
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  expenseDate DateTime?

  // Original OCR receipt — immutable after expense creation
  ocrReceiptUrl  String?
  ocrReceiptPath String?
  ocrRawText     String?

  // Bill proof
  billProofUrl  String?
  billProofPath String?

  // Approval workflow
  status          ExpenseStatus @default(PENDING)
  decidedAt       DateTime?
  decidedById     Int?
  rejectionReason String?

  // Reimbursement workflow
  reimbursementStatus ReimbursementStatus @default(PENDING)
  reimbursementAt     DateTime?
  reimbursementById   Int?
  reimbursementReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int?

  decidedBy User? @relation("ExpenseDecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)

  reimbursementBy User? @relation("ExpenseReimbursementProcessor", fields: [reimbursementById], references: [id], onDelete: SetNull)

  auditLogs ExpenseAuditLog[]
}

model RoleVerificationRequest {
  id Int @id @default(autoincrement())

  requestedRole Role

  proofUrl  String?
  proofPath String?

  status RoleRequestStatus @default(PENDING)

  rejectionReason String?

  reviewedAt   DateTime?
  reviewedById Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("RoleRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model EmployeeVerificationRequest {
  id Int @id @default(autoincrement())

  proofUrl  String?
  proofPath String?

  status EmployeeVerificationStatus @default(PENDING)

  rejectionReason String?

  reviewedAt   DateTime?
  reviewedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("EmployeeVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model ExpenseAuditLog {
  id        Int                @id @default(autoincrement())
  action    ExpenseAuditAction
  reason    String?
  metadata  Json?
  details   String?
  createdAt DateTime           @default(now())

  expenseId Int?
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  actorId Int?
  actor   User? @relation("ExpenseAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
}

model DeletedExpense {
  id Int @id @default(autoincrement())

  originalExpenseId Int

  title       String
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  expenseDate DateTime?

  ocrReceiptUrl  String?
  ocrReceiptPath String?
  ocrRawText     String?

  billProofUrl  String?
  billProofPath String?

  deletionReason String

  deletedAt   DateTime @default(now())
  deletedById Int

  userId Int

  user User @relation("DeletedExpenseOwner", fields: [userId], references: [id], onDelete: Restrict)

  deletedBy User @relation("DeletedExpenseAdmin", fields: [deletedById], references: [id], onDelete: Restrict)
}
